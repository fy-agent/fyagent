    ]
  },
  "inputs": [
    {
      "id": "business-input",
      "label": "业务输入",
      "description": "使用获授权来源并核对口径；随包数据全部为虚构样例，不填入真实客户内容。",
      "required": true
    }
  ],
  "connections": [
    {
      "id": "source",
      "recipeId": "yuque",
      "purpose": "在真实项目中按授权只读获取来源；合成演示不调用连接。",
