{
  "schemaVersion": "fyagent-delivery-kit/v1",
  "id": "knowledge-support",
  "version": "1.0.0",
  "title": "知识客服",
  "summary": "入门准备包：包含合成样例和人工检查步骤，真实系统接入需另行验证。",
  "scenario": "knowledge_support",
